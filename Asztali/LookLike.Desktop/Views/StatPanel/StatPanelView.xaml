<UserControl x:Class="LookLike.Desktop.Views.StatPanel.StatPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:LookLike.Desktop.ViewModels.StatPanel"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1300" d:Background="#2E2A4F">

    <Grid Margin="40">
        <Border CornerRadius="20" Background="#403A77" Padding="30">
            <StackPanel>

                <TextBlock Text="📊 Statisztikai Panel" 
                           FontSize="32" FontWeight="Bold" 
                           Foreground="#FFD700"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,30"/>

                <UniformGrid Rows="3" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">

                    <TextBlock Text="Értékelések száma:" 
                               Foreground="White" 
                               FontSize="18" 
                               VerticalAlignment="Center" 
                               Margin="5"/>

                    <TextBox Width="220" Height="40" 
                             Text="{Binding Ertekeles, Mode=TwoWay}" 
                             FontSize="16" 
                             Padding="10" 
                             Background="#FFFFFF" 
                             BorderThickness="0" 
                             Margin="5"/>

                    <TextBlock Text="Munkanapok száma:" 
                               Foreground="White" 
                               FontSize="18" 
                               VerticalAlignment="Center" 
                               Margin="5"/>

                    <TextBox Width="220" Height="40" 
                             Text="{Binding Munkanapok, Mode=TwoWay}" 
                             FontSize="16" 
                             Padding="10" 
                             Background="#FFFFFF" 
                             BorderThickness="0" 
                             Margin="5"/>

                    <TextBlock Text="Átlag:" 
                               Foreground="White" 
                               FontSize="18" 
                               VerticalAlignment="Center" 
                               Margin="5"/>

                    <TextBox Width="220" Height="40" 
                             Text="{Binding Atlag, Mode=OneWay}" 
                             IsReadOnly="True" 
                             FontSize="16" 
                             Padding="10" 
                             Background="#DDDDDD" 
                             BorderThickness="0" 
                             Margin="5"/>
                </UniformGrid>

                <Button Content="➔ Számolás" 
                        Width="250" Height="50" 
                        Background="#FFD700" 
                        Foreground="#2E2A4F" 
                        FontSize="20" 
                        FontWeight="Bold"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Cursor="Hand"
                        Command="{Binding SzamolasCommand}">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="#FFC300"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
