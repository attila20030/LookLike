<UserControl x:Class="LookLike.Desktop.Views.ManagmentPanel.AdminManagment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:LookLike.Desktop.Views.ManagmentPanel"
    xmlns:viewmodels="clr-namespace:LookLike.Desktop.ViewModels" 
    xmlns:base="clr-namespace:LookLike.Desktop.ViewModels.Base" 
    xmlns:managment="clr-namespace:LookLike.Desktop.ViewModels.ManagmentPanel"
    d:DataContext="{d:DesignInstance Type=managment:ManagmentPanelViewModel}"
             
             mc:Ignorable="d"
    Height="650" Width="1000">
    <Grid Background="Transparent">
        <Label VerticalAlignment="Top" HorizontalAlignment="Center" FontWeight="Bold" FontSize="20" Foreground="White">Felhasználók Kezelése</Label>
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <Button
                Command="{Binding ShowAdminCreateViewCommand}"
                Content="Új tag felvétele" Width="125" Height="100" 
                Background="#5c509c" Foreground="White" BorderThickness="5" Margin="0,0,30,0" BorderBrush="Black">
            </Button>
            <Button 
                Command="{Binding ShowAdminDeleteViewCommand}"
                Content="Tag törlése" Width="125" Height="100" 
                Background="#5c509c" Foreground="White" BorderThickness="5" Margin="0,0,30,0" BorderBrush="Black">
            </Button>
            <Button Command="{Binding ShowAdminSeeViewCommand}"
                Content="Tagok megtekintése" Width="125" Height="100" 
                Background="#5c509c" Foreground="White" BorderThickness="5" BorderBrush="Black">
            </Button>
        </StackPanel>
        <ContentControl  Content="{Binding CurrentViewModel}"></ContentControl>
    </Grid>
</UserControl>
