<UserControl x:Class="LookLike.Desktop.Views.Menu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LookLike.Desktop.Views"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:viewmodels="clr-namespace:LookLike.Desktop.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel,IsDesignTimeCreatable=True}"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="120">
    <StackPanel>
        <Border CornerRadius="25, 0, 0,25" Background="#5c509c">
            
            <StackPanel Orientation="Vertical" Height="700">
                <StackPanel Orientation="Vertical" Margin="0 10 0 20">
                    <Border Width="80" 
                            Height="80" 
                            Padding="1" 
                            Margin="0 10 0 10" 
                            >
                        <Ellipse Height="80" Width="80"
                                                      
                            StrokeThickness="2"                                 
                            Margin="-1,-1,-1,-1">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/profile.jpg"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Border>
                    <!--Menu Buttons-->
                    <RadioButton 
                        Style="{StaticResource menuButton}"
                                                     
                        IsChecked="True"
                        Command="{Binding ShowDashbordCommand}" Checked="RadioButton_Checked"
                        >
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Foreground="#382d72"  Icon="UserGroup" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Profil"  Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        Style="{StaticResource menuButton}"
                        Tag="{StaticResource colorMidCreamy}"
                        Command="{Binding ShowManagmentPanelCommand}"                     
                     >
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Save" Foreground="#382d72" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Adatvédelem" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource menuButton}"
                            
                                 Command="{Binding ShowNotificationPanelCommand}"
                                 >
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Book" Foreground="#382d72" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Jegyzet"  Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource menuButton}"
                             
                                 Command="{Binding ShowStatPanelCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="ChartLine" Foreground="#382d72" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Statisztika" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton Style="{StaticResource menuButton}"
                             
                                 Command="{Binding ShowRegistrationPanelCommand}"
                                 >
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Pencil" Foreground="#382d72" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Regisztráció"  Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
